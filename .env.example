# Đổi thành tên SQL Server hiển thị trong cửa sổ kết nối SSMS
# Ví dụ: localhost\SQLEXPRESS hoặc DESKTOP-ABC\SQLEXPRESS
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=QL_ThoiTrang
# windows: đăng nhập Windows Authentication | sql: tài khoản SQL Server
SQL_AUTH=windows
SQL_USER=sa
SQL_PASSWORD=
# Để trống để tự chọn ODBC Driver 18 hoặc 17 được cài
SQL_DRIVER=
# Tự đặt chuỗi bí mật đủ dài, ví dụ tạo bằng: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=thay-doi-thanh-chuoi-ngau-nhien-dai
FLASK_DEBUG=1
